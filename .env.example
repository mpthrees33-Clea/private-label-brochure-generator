DATABASE_URL="file:./prisma/dev.db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
SHARED_PASSWORD="trinity"
ANTHROPIC_API_KEY=""
BLOB_READ_WRITE_TOKEN=""
# PDF export renders brochure HTML in memory and prints it with headless
# Chrome. It does not fetch the app's public URL or 127.0.0.1, so nginx
# basic auth and Vercel Deployment Protection do not apply.
#
# VPS / local: path to system Chrome. Required in production on the VPS.
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/google-chrome-stable"
#
# Vercel: leave PUPPETEER_EXECUTABLE_PATH unset. The function downloads
# @sparticuz/chromium-min's pack on cold start (needs outbound HTTPS and
# /tmp). Optional override if GitHub is slow or blocked:
# CHROMIUM_PACK_URL="https://github.com/Sparticuz/chromium/releases/download/v148.0.0/chromium-v148.0.0-pack.x64.tar"
