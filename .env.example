DATABASE_URL="file:./prisma/dev.db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
SHARED_PASSWORD="trinity"
ANTHROPIC_API_KEY=""
BLOB_READ_WRITE_TOKEN=""
# PDF export loads brochure HTML from the Node process itself so headless
# Chrome never crosses nginx basic auth (ERR_INVALID_AUTH_CREDENTIALS).
# Unset uses http://127.0.0.1:$PORT (or :3000). Set this only if Node
# listens somewhere else, e.g. http://127.0.0.1:3002
# PDF_RENDER_ORIGIN=""
# If PDF_RENDER_ORIGIN is a public URL that still requires HTTP basic
# auth, pass credentials here. Do not commit real passwords.
# PDF_RENDER_BASIC_AUTH="username:password"
